{
  "name": "ts-twitch-api",
  "version": "0.3.1",
  "description": "Very simple TwitchApi class and TypeScript interfaces for all Twitch API endpoints",
  "keywords": [
    "api",
    "autogenerated",
    "client",
    "twitch"
  ],
  "bugs": {
    "url": "https://github.com/DmitryScaletta/ts-twitch-api/issues"
  },
  "license": "MIT",
  "author": "DmitryScaletta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitryScaletta/ts-twitch-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "build": "pnpm build:src && tsdown",
    "build:src": "node ./scripts/build.ts",
    "gen": "pnpx openapi-typescript@6 https://github.com/DmitryScaletta/twitch-api-swagger/raw/main/openapi.json --output src/twitch-api.generated.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --ignore-pattern src/twitch-api.ts --ignore-pattern src/twitch-api.generated.ts",
    "lint:ts": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
